<?xml version="1.0" encoding="utf-8"?>
<!-- Updated Login Screen - Exact match with Image 1 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Label at the very top left -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_page_label"
        android:textColor="@color/text_secondary"
        android:layout_margin="16dp"
        android:textSize="18sp"
        android:alpha="0.7" />

    <!-- Main Login Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="24dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="32dp"
        android:elevation="8dp">

        <!-- Circular User Icon -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_user_circle"
            app:tint="@color/text_secondary"
            android:contentDescription="User Icon" />

        <!-- Welcome Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="@string/welcome_title"
            android:textColor="@color/text_main"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/login_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Username Input Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/username_label"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_username"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/username_hint"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_hint"
            android:inputType="text"
            android:autofillHints="username" />

        <!-- Password Input Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/password_label"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field">

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="********"
                android:paddingStart="16dp"
                android:paddingEnd="52dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_hint"
                android:inputType="textPassword"
                android:autofillHints="password" />

            <ImageButton
                android:id="@+id/ib_eye"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_secure"
                app:tint="@color/text_secondary"
                android:contentDescription="Toggle Visibility" />
        </RelativeLayout>

        <!-- Error Message -->
        <TextView
            android:id="@+id/tv_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FF5252"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Bright Purple Login Button -->
        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_button_purple"
            android:text="@string/login_button"
            android:textAllCaps="false"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </LinearLayout>

</RelativeLayout>
