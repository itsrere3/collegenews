BEGIN
    UPDATE learningresources
    SET avg_star_rating = (
        SELECT ROUND(AVG(star_rating), 1)
        FROM user_resource_comment
        WHERE resource_id = NEW.resource_id
    )
    WHERE resource_id = NEW.resource_id;
END
